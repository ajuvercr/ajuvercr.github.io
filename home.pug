doctype html
include includes/head.pug

mixin project-card(name, href, label, logo, desc, decorative)
  a.marquee__card(href=href target="_blank" rel="noopener" aria-label=label tabindex=decorative ? "-1" : undefined)
    span.marquee__logo
      img(src=logo alt="" width="28" height="28" loading="lazy")
    span.marquee__card-text
      span.marquee__card-title= name
      span.marquee__card-desc= desc

mixin bench-row(label, myWidth, myValue, badWidth, badValue)
  li.benchmark__row
    span.benchmark__label= label
    div.benchmark__bar-line
      span.benchmark__bar
        span.benchmark__fill(style=`width: ${myWidth}`)
      span.benchmark__value= myValue
    div.benchmark__bar-line.benchmark__bar-line--bad
      span.benchmark__bar
        span.benchmark__fill.benchmark__fill--bad(style=`width: ${badWidth}`)
      span.benchmark__value.benchmark__value--bad= badValue

mixin project-cards(decorative)
  +project-card('SWLS', 'https://github.com/SemanticWebLanguageServer/swls', 'SWLS — Semantic Web Language Server, on GitHub', 'images/swls-logo.png', 'Intellisense for Turtle & SPARQL, 5,000+ installs', decorative)
  +project-card('RDF-Connect', 'https://github.com/rdf-connect/', 'RDF-Connect, on GitHub', 'images/rdf-connect-logo.png', 'Streaming RDF pipelines with built-in provenance', decorative)
  +project-card('RDF-Lens', 'https://github.com/ajuvercr/rdf-lens', 'RDF-Lens, on GitHub', 'images/rdf-lens-logo.png', 'Composable, typed extraction from RDF graphs', decorative)
  +project-card('LDES Client', 'https://github.com/rdf-connect/ldes-client/', 'LDES Client, on GitHub', 'images/ldes-logo.svg', 'Async client for Linked Data Event Streams', decorative)

html(lang="en")
  +head(title, description, og, stylesheets)

  body.home
    a.skip-link(href="#about") Skip to main content

    header.hero
      div.hero__terminal
        p.hero__eyebrow
          span.prompt $
          |  whoami
        h1.hero__name Arthur Vercruysse
        p.hero__tagline
          | Developer for semantic Web developers.
          span.cursor(aria-hidden="true")

    main
      section#about.reveal(aria-labelledby="about-heading").container
        h2#about-heading.section-heading ABOUT&nbsp;{
        p.section-comment // whoami
        .section-body
          p.
            PhD researcher in Computer Science Engineering at Ghent University, building
            open-source developer tooling, streaming RDF pipelines, and Linked Data clients
            for the FOSS Semantic Web community.
          p.
            My work centers on live, provenance-tracked knowledge graphs — which is what led
            to building #[code RDF-Connect] and the #[code Semantic Web Language Server],
            tools now used by other Semantic Web developers rather than just myself.
          p.
            Outside of work, I'm usually bouldering, chipping away at renovating my house,
            or building small tools I didn't strictly need — see Projects below.
        span.brace-close }

      div.marquee(role="region" aria-label="Featured projects")
        div.marquee__track
          div.marquee__group
            +project-cards()
          div.marquee__group.marquee__group--dup(aria-hidden="true")
            +project-cards(true)
          div.marquee__group.marquee__group--dup(aria-hidden="true")
            +project-cards(true)
          div.marquee__group.marquee__group--dup(aria-hidden="true")
            +project-cards(true)

      div.benchmark
        p.benchmark__title $ arthur --benchmark --trust-me-bro --vs=some-random-dev
        p.benchmark__legend
          span.benchmark__legend-swatch.benchmark__legend-swatch--me
          |  me
          span.benchmark__legend-swatch.benchmark__legend-swatch--bad
          |  some-random-dev
        ul.benchmark__list
          +bench-row('Semantic Web wizardry', '100%', '100%', '4%', '4%')
          +bench-row('RDF triples per cup of coffee', '100%', '9000+', '2%', '0')
          +bench-row('Bugs fixed via "turn it off and on again"', '12%', '12%', '97%', '97%')
          +bench-row('Trust me bro accuracy', '100%', '100%', '5%', 'N/A')
        p.benchmark__footnote // independently verified by nobody, n=1 (some-random-dev may or may not exist)

